# Copy to .env.local and fill in. Never commit the filled in file.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# QuickBooks Online
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
QBO_REDIRECT_URI=http://localhost:3000/api/qbo/callback
QBO_ENVIRONMENT=sandbox

# Encrypts the QBO access and refresh tokens before they are stored in Supabase.
# Generate with: openssl rand -base64 32
QBO_TOKEN_ENCRYPTION_KEY=

# Shared secret for the scheduled sync at /api/qbo/sync. Vercel sets this
# automatically for cron jobs; set it yourself for any other scheduler.
CRON_SECRET=

# Operating timezone used to decide what "today" means on the route.
APP_TIME_ZONE=America/Chicago
